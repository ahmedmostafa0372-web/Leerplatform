.world-app { flex-direction: row; flex-grow: 1; width: 100%; height: 100%; background-color: #151e30; color: #f2f5ff; -unity-font-definition: none; }
.sidebar { width: 16%; min-width: 185px; background-color: #303345; padding-top: 24px; padding-left: 20px; padding-right: 12px; justify-content: space-between; }
.brand-row { flex-direction: row; align-items: center; margin-bottom: 24px; }
.brand-icon { background-color: #4b80f2; border-radius: 11px; width: 44px; height: 44px; font-size: 28px; -unity-text-align: middle-center; color: white; margin-right: 12px; }
.brand-text { font-size: 23px; -unity-font-style: bold; }
.nav-block { flex-grow: 1; padding-top: 10px; }
.nav-item { height: 53px; padding-left: 16px; -unity-text-align: middle-left; font-size: 17px; margin-bottom: 6px; color: #e6eaf4; border-radius: 12px; }
.nav-active { background-color: #477ff0; color: white; -unity-font-style: bold; }
.subject-label { background-color: #4b4d62; border-radius: 11px; padding: 15px; font-size: 16px; margin-bottom: 20px; }
.world-main { flex-grow: 1; padding-left: 28px; padding-right: 24px; padding-top: 45px; padding-bottom: 20px; }
.header-row { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 28px; }
.header-copy { flex-grow: 1; padding-right: 18px; }
.eyebrow { color: #b8c8e7; font-size: 15px; margin-bottom: 14px; }
.main-title { color: #f5f7ff; font-size: 43px; -unity-font-style: bold; margin-bottom: 7px; border-left-width: 7px; border-left-color: #578bf6; padding-left: 16px; }
.subtitle { color: #c0cce0; font-size: 19px; margin-left: 24px; white-space: normal; }
.progress-panel { width: 37%; min-width: 275px; background-color: #1d2940; border-width: 1px; border-color: #475774; border-radius: 18px; padding: 18px 23px; }
.progress-top { flex-direction: row; align-items: center; margin-bottom: 14px; }
.progress-icon { font-size: 38px; color: #8fb5ff; margin-right: 15px; }
.progress-number { font-size: 36px; -unity-font-style: bold; margin-right: 14px; }
.progress-description { color: #c3d0e7; font-size: 16px; white-space: normal; flex-grow: 1; }
.progress-track, .leader-track { background-color: #46536e; border-radius: 9px; height: 14px; overflow: hidden; }
.progress-fill, .leader-bar { width: 0%; height: 100%; background-color: #588ff8; border-radius: 9px; }
.content-row { flex-direction: row; flex-grow: 1; min-height: 0; }
.map-column { flex-grow: 1; min-width: 0; margin-right: 18px; }
.map-frame { position: relative; background-color: #1a253a; border-width: 1px; border-color: #4b5d7b; border-radius: 18px; overflow: hidden; flex-grow: 0; }
.map-surface { position: relative; width: 100%; }
.map-base, .map-highlight { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: stretch-to-fill; }
.map-legend { flex-direction: row; align-items: center; margin-top: 17px; margin-left: 10px; }
.legend-blue, .legend-gray { width: 34px; height: 27px; border-radius: 5px; margin-right: 9px; }
.legend-blue { background-color: #528af4; }
.legend-gray { background-color: #5a637a; margin-left: 22px; }
.legend-text { font-size: 15px; color: #dbe4f5; }
.region-popup { position: absolute; width: 265px; background-color: #1b2840; border-width: 1px; border-color: #5a7096; border-radius: 16px; padding: 16px; }
.hidden { display: none; }
.popup-name { font-size: 22px; color: white; -unity-font-style: bold; margin-bottom: 11px; }
.popup-topic { color: #d6e0f1; font-size: 15px; margin-bottom: 14px; white-space: normal; }
.start-button { background-color: #4c82ef; border-width: 0; border-radius: 10px; height: 42px; color: white; font-size: 15px; -unity-font-style: bold; }
.start-button:hover { background-color: #669afa; }
.leaderboard { width: 30%; min-width: 265px; background-color: #1e2a40; border-width: 1px; border-color: #4b5d7b; border-radius: 18px; padding: 22px 17px; }
.leader-title { font-size: 24px; -unity-font-style: bold; margin-bottom: 22px; }
.leader-row { flex-direction: row; align-items: center; margin-bottom: 17px; padding: 8px; border-radius: 12px; }
.leader-self { background-color: #2c446a; }
.leader-medal { width: 39px; height: 39px; border-radius: 20px; -unity-text-align: middle-center; font-size: 21px; margin-right: 13px; color: #25324b; }
.gold { background-color: #f0d16e; } .silver { background-color: #bbc7dc; } .bronze { background-color: #d0a47f; } .self { background-color: #5289f2; } .muted { background-color: #5b6881; color: white; }
.leader-details { flex-grow: 1; }
.leader-line { flex-direction: row; justify-content: space-between; margin-bottom: 8px; font-size: 15px; }
.leader-track { height: 11px; }
.leader-footnote { color: #8497b6; font-size: 11px; margin-top: 8px; }
